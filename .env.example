# Vaultory Environment Configuration Example
PROJECT_NAME="Vaultory"
SECRET_KEY="your_secret_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL primary with automatic SQLite fallback)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/vaultory"

# External AI & OCR Services
OPENAI_API_KEY=""
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Cloud Storage (Cloudinary - optional; local storage used when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Telegram Bot API Notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="VaultoryWarrantyBot"
